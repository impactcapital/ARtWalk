# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server/edge functions only

# ── 8th Wall ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_8THWALL_API_KEY=your-8thwall-key      # get from 8thwall.com/dashboard

# ── MapLibre (optional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key        # free tier covers development

# ── Citizen Science APIs ──────────────────────────────────────────────────────
SCISTARTER_API_KEY=your-scistarter-key            # request at scistarter.org/api
INATURALIST_JWT=your-inaturalist-jwt              # from inaturalist.org/users/api_token (24h)

# ── Data Refinery (server/admin only) ────────────────────────────────────────
EXPORT_SERVICE_KEY=your-export-service-key        # random secret, guards export-dataset fn
